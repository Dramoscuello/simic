# SIMIC Docker — archivo de entorno
# Copiar a .env y editar con valores reales
# NOTA: HOST_POSTGRES=postgres y REDIS_URL=redis://redis:6379/0 se fijan en docker-compose.yml

# ─── Base de datos (credenciales - las mismas que usará postgres container) ───
USER_POSTGRES=simic
PASS_POSTGRES=cambia_esta_password
DB_POSTGRES=simic_db

# ─── Seguridad ───
SECRET_KEY=cambia_esta_clave_larga_y_aleatoria

# ─── Frontend ───
# Usa http://<ip-del-servidor> si despliegas en VPS sin dominio aun.
# Cambialo a tu dominio real cuando tengas uno (ej: https://simic.mi-colegio.edu.co).
FRONTEND_URL=http://localhost

# ─── SMTP (notificaciones por correo) ───
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_password_de_aplicacion
MAIL_FROM=tu_correo@gmail.com
MAIL_PORT=465
MAIL_SERVER=smtp.gmail.com

# ─── IA (fallback opcional, preferible configurar desde /setup) ───
OPENAI_API_KEY=sk-...
CLAUDE_API_KEY=sk-ant-...
OPENAI_BASE_URL=
DEFAULT_GENERATION_MODEL=o3
WOLFRAM_APP_ID=...

# ─── Simulacros (opcional) ───
SIMULACRO_MARGIN_MINUTES=5
SIMULACRO_MIN_FINISH_PCT=0.30
